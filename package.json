{
  "name": "reckoning",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "test:e2e": "pnpm test:e2e:run",
    "test:e2e:run": "playwright test",
    "test:e2e:open": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install --with-deps",
    "test:e2e:startserver": "RAILS_ENV=test bundle exec puma -C config/puma.rb"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo": "^8.0.23",
    "pdfjs-dist": "4.10.38",
    "puppeteer": "^23.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.2.2",
    "vite": "^7.3.5",
    "vite-plugin-ruby": "^5.2.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@playwright/test",
      "esbuild",
      "puppeteer"
    ]
  }
}
