{
  "name": "reckoning",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "pnpm generate-api-client",
    "generate-api-client": "orval -c orval.config.ts",
    "validate-schema": "redocly lint ./swagger/v1/schema.yaml",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "pnpm test:e2e:run",
    "test:e2e:run": "playwright test",
    "test:e2e:open": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install --with-deps",
    "test:e2e:startserver": "RAILS_ENV=test WORKER_COUNT=0 bundle exec puma -C config/puma.rb"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo": "^8.0.23",
    "@rails/actioncable": "^8.1.301",
    "@tanstack/vue-query": "^5.102.8",
    "@vee-validate/zod": "^4.15.1",
    "accounting": "^0.4.1",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "pdfjs-dist": "4.10.38",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "puppeteer": "^25.9.0",
    "qs": "^6.16.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@redocly/cli": "^2.49.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/accounting": "^0.4.5",
    "@types/hotwired__turbo": "^8.0.16",
    "@types/node": "^26.4.1",
    "@types/qs": "^6.15.1",
    "@types/rails__actioncable": "^8.0.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.12.0",
    "orval": "^8.27.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-ruby": "^5.2.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@playwright/test",
      "esbuild",
      "puppeteer"
    ]
  }
}
