{
  "name": "reckoning",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "test:e2e": "pnpm test:e2e:run",
    "test:e2e:run": "playwright test",
    "test:e2e:open": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install --with-deps",
    "test:e2e:startserver": "RAILS_ENV=test WORKER_COUNT=0 bundle exec puma -C config/puma.rb"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo": "^8.0.23",
    "@rails/actioncable": "^8.1.300",
    "accounting": "^0.4.1",
    "dayjs": "^1.11.21",
    "pdfjs-dist": "4.10.38",
    "puppeteer": "^23.0.0",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.3.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.2.2",
    "vite": "^8.0.16",
    "vite-plugin-ruby": "^5.2.2",
    "vue-tsc": "^3.3.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@playwright/test",
      "esbuild",
      "puppeteer"
    ]
  }
}
