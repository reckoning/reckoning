{
  "name": "reckoning",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "pnpm generate-api-client",
    "generate-api-client": "orval -c orval.config.ts",
    "validate-schema": "redocly lint ./swagger/v1/schema.yaml",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "pnpm test:e2e:run",
    "test:e2e:run": "playwright test",
    "test:e2e:open": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install --with-deps",
    "test:e2e:startserver": "RAILS_ENV=test WORKER_COUNT=0 bundle exec puma -C config/puma.rb"
  },
  "dependencies": {
    "@appsignal/javascript": "^1.6.1",
    "@appsignal/plugin-window-events": "^1.0.26",
    "@appsignal/vue": "^1.1.7",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo": "^8.0.23",
    "@rails/actioncable": "^8.1.401",
    "@tanstack/vue-query": "^5.108.4",
    "@vee-validate/zod": "^4.15.1",
    "accounting": "^0.4.1",
    "axios": "^1.21.1",
    "dayjs": "^1.11.23",
    "pdfjs-dist": "4.10.38",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "puppeteer": "^25.18.1",
    "qs": "^6.17.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.23",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@redocly/cli": "^2.83.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/accounting": "^0.4.5",
    "@types/hotwired__turbo": "^8.0.17",
    "@types/node": "^26.6.7",
    "@types/qs": "^6.15.1",
    "@types/rails__actioncable": "^8.0.3",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "happy-dom": "^20.12.0",
    "orval": "^8.49.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-ruby": "^5.2.6",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@playwright/test",
      "esbuild",
      "puppeteer"
    ]
  }
}
