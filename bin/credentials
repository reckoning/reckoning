#!/usr/bin/env bash
set -euo pipefail

VAULT="Reckoning"

usage() {
  echo "Usage: bin/credentials <environment>"
  echo ""
  echo "Edit Rails credentials using keys from 1Password."
  echo ""
  echo "Environments:"
  echo "  production   Edit config/credentials/production.yml.enc"
  echo "  shared       Edit config/credentials.yml.enc"
  exit 1
}

if [ $# -lt 1 ]; then
  usage
fi

ENV="$1"

case "$ENV" in
  production)
    OP_ITEM="RAILS_MASTER_KEY_LIVE"
    RAILS_ENV_FLAG="--environment production"
    ;;
  shared)
    # config/credentials.yml.enc is encrypted with config/master.key, which is a
    # different key from the production one.
    OP_ITEM="RAILS_MASTER_KEY_DEV"
    RAILS_ENV_FLAG=""
    ;;
  *)
    echo "Error: unknown environment '$ENV'"
    echo ""
    usage
    ;;
esac

if ! command -v op &> /dev/null; then
  echo "Error: 1Password CLI (op) is not installed."
  echo "Install it from: https://developer.1password.com/docs/cli/get-started/"
  exit 1
fi

echo "Fetching key for $ENV from 1Password..."
RAILS_MASTER_KEY=$(op read "op://$VAULT/$OP_ITEM/credential")
export RAILS_MASTER_KEY

# --wait is required: Rails re-encrypts whatever is on disk once the editor
# exits, so an editor that returns immediately shows an empty buffer and
# silently discards the edit.
export EDITOR="code --wait"

# shellcheck disable=SC2086
exec bin/rails credentials:edit $RAILS_ENV_FLAG
