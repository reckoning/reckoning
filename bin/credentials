#!/usr/bin/env bash
set -euo pipefail

# Edit Rails credentials with the key pulled from 1Password, so the master key
# never has to sit on disk.
#
# Usage: bin/credentials production
#        bin/credentials shared

VAULT="Reckoning"

usage() {
  echo "Usage: bin/credentials <environment>"
  echo ""
  echo "Environments:"
  echo "  production   Edit config/credentials/production.yml.enc"
  echo "  shared       Edit config/credentials.yml.enc"
  exit 1
}

[ $# -lt 1 ] && usage

case "$1" in
  production)
    OP_ITEM="RAILS_MASTER_KEY_LIVE"
    ENV_FLAG="--environment production"
    ;;
  shared)
    # config/credentials.yml.enc is encrypted with config/master.key, which is a
    # different key from the production one.
    OP_ITEM="RAILS_MASTER_KEY_DEV"
    ENV_FLAG=""
    ;;
  *)
    echo "Error: unknown environment '$1'" >&2
    echo ""
    usage
    ;;
esac

if ! command -v op >/dev/null; then
  echo "Error: the 1Password CLI (op) is not installed." >&2
  echo "Install it from: https://developer.1password.com/docs/cli/get-started/" >&2
  exit 1
fi

RAILS_MASTER_KEY=$(op read "op://$VAULT/$OP_ITEM/credential")
export RAILS_MASTER_KEY

# Rails writes the decrypted file, spawns $EDITOR, then re-encrypts whatever is
# on disk once it exits. An editor that returns immediately therefore shows an
# empty buffer and silently discards edits — so require a blocking one.
if [ -z "${EDITOR:-}" ]; then
  if command -v code >/dev/null; then
    export EDITOR="code --wait"
  else
    echo "Error: set EDITOR to a blocking editor, e.g. 'export EDITOR=\"code --wait\"' or 'vim'." >&2
    exit 1
  fi
fi

case "$EDITOR" in
  code|code\ *)
    if [[ "$EDITOR" != *--wait* ]]; then
      echo "Error: EDITOR is '$EDITOR' — VS Code returns immediately without --wait," >&2
      echo "which opens an empty buffer and discards your edits. Use 'code --wait'." >&2
      exit 1
    fi
    ;;
esac

# shellcheck disable=SC2086
exec bin/rails credentials:edit $ENV_FLAG
