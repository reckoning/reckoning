#!/usr/bin/env bash
set -euo pipefail

# Edit Rails credentials with the key pulled from 1Password, so the master key
# never has to sit on disk.
#
# Usage: bin/credentials production
#        bin/credentials shared

VAULT="Reckoning"

usage() {
  echo "Usage: bin/credentials <environment>"
  echo ""
  echo "Environments:"
  echo "  production   Edit config/credentials/production.yml.enc"
  echo "  shared       Edit config/credentials.yml.enc"
  exit 1
}

[ $# -lt 1 ] && usage

case "$1" in
  production)
    OP_ITEM="RAILS_MASTER_KEY_LIVE"
    ENV_FLAG="--environment production"
    ;;
  shared)
    OP_ITEM="RAILS_MASTER_KEY_LIVE"
    ENV_FLAG=""
    ;;
  *)
    echo "Error: unknown environment '$1'" >&2
    echo ""
    usage
    ;;
esac

if ! command -v op >/dev/null; then
  echo "Error: the 1Password CLI (op) is not installed." >&2
  echo "Install it from: https://developer.1password.com/docs/cli/get-started/" >&2
  exit 1
fi

RAILS_MASTER_KEY=$(op read "op://$VAULT/$OP_ITEM/credential")
export RAILS_MASTER_KEY
export EDITOR="${EDITOR:-code --wait}"

# shellcheck disable=SC2086
exec bin/rails credentials:edit $ENV_FLAG
