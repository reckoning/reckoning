VAULT="Reckoning"

# Decrypts config/credentials/production.yml.enc, which supplies secret_key_base,
# the devise secrets, mailer credentials and — importantly — the
# active_record_encryption keys. Without the matching key, every encrypted
# column reads back as garbage rather than failing loudly.
RAILS_MASTER_KEY=$(op read "op://$VAULT/RAILS_MASTER_KEY_LIVE/credential")

POSTGRES_USER=$(op read "op://$VAULT/POSTGRES_LIVE/username")
POSTGRES_PASSWORD=$(op read "op://$VAULT/POSTGRES_LIVE/credential")

# Postgres and Redis run as accessories on the web server itself, so these
# resolve over the Docker network rather than a private server IP. If the
# datastores ever move to a dedicated accessories host, replace the hostnames
# with that host's private IP (terraform output accessory_private_ips).
DATABASE_URL=postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@reckoning-db:5432/reckoning_production
REDIS_URL=redis://reckoning-redis:6379/0
