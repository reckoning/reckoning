# Secrets shared by every destination, fetched from 1Password (vault: Reckoning).
#
# Locally this uses the `op` CLI — run `op signin` and export OP_ACCOUNT.
# In CI, OP_SERVICE_ACCOUNT_TOKEN replaces both.
#
# This file contains no secret material and is committed deliberately.

VAULT="Reckoning"

# Object Storage credentials for the postgres-backup-s3 accessory.
#
# These read the item's TOP-LEVEL username/credential fields rather than custom
# fields, because reckoning/infrastructure's Terraform can only read those and
# both must resolve to the same key pair.
S3_ACCESS_KEY_ID=$(op read "op://$VAULT/HETZNER_S3/username")
S3_SECRET_ACCESS_KEY=$(op read "op://$VAULT/HETZNER_S3/credential")

# CI injects the built-in GITHUB_TOKEN, which is scoped to this repository and
# needs no vault entry. Fall back to a PAT for local deploys.
KAMAL_REGISTRY_USERNAME=${KAMAL_REGISTRY_USERNAME:-$(op read "op://$VAULT/KAMAL_REGISTRY_LIVE/username")}
KAMAL_REGISTRY_PASSWORD=${KAMAL_REGISTRY_PASSWORD:-$(op read "op://$VAULT/KAMAL_REGISTRY_LIVE/credential")}
