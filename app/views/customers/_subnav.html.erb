<ul class="nav nav-tabs-vertical">
  <% [
       ["#basic", "fa-book",             "nav.subnav.customer.basic", true],
       ["#email", "fa-paper-plane",      "nav.subnav.customer.email", false],
       ["#offer", "fa-hand-holding-box", "nav.subnav.customer.offer", false]
     ].each do |href, icon, label_key, active| %>
    <li class="<%= "active" if active %>">
      <a href="<%= href %>" data-toggle="tab">
        <%= I18n.t(label_key) %>
        <i class="fa <%= icon %> fa-fw"></i>
      </a>
    </li>
  <% end %>
</ul>
