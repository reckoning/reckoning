<% content_for :title do %>
  <%= I18n.t(:"meta.title.customer.edit") %>
<% end %>

<div class="row" id="edit-customer">
  <div class="col-xs-12 col-md-12">

    <div class="row">
      <div class="col-xs-12 col-md-9">
        <h1>
          <%= I18n.t(:"headlines.customer.edit") %>
        </h1>
      </div>

      <div class="col-xs-12 col-md-3">
        <div class="btn-group btn-group-justified-responsive pull-right resource-nav">
          <%= link_to I18n.t(:"nav.subnav.back"), :back, class: "btn btn-default" %>
          <a class="btn btn-danger" href="<%= v1_customer_url(customer) %>" data-redirect="<%= projects_path %>" data-method="DELETE" data-notyConfirm="<%= I18n.t(:"messages.confirm.delete") %>">
            <i class="fa fa-trash"></i>
            <%= I18n.t(:"actions.delete") %>
          </a>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-xs-12 col-lg-2 col-md-3 col-sm-3">
        <%= render "subnav" %>
      </div>

      <div class="col-xs-12 col-lg-10 col-md-9 col-sm-9">
        <%= render "form" %>
      </div>
    </div>
  </div>
</div>
