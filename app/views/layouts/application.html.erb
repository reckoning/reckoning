<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <%= render "layouts/head" %>
  </head>
  <body data-success="<%= flash[:success] %>" data-info="<%= notice %>" data-error="<%= alert %>">
    <% if user_signed_in? %>
      <%= render "layouts/navigation" %>
    <% end %>
    <div class="container-fluid">
      <div class="row">
        <div class="col-xs-12 col-md-10 col-md-offset-2 col-xl-11 col-xl-offset-1">
          <% if user_signed_in? %>
            <%= render "layouts/trial_banner" %>
          <% end %>
          <%== yield %>
        </div>
      </div>
    </div>
  </body>
</html>
