<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title %></title>

    <link rel="shortcut icon" type="image/png" href="<%= asset_url("favicon.png") %>">

    <%# The brand face, same as the server-rendered layout. %>
    <%= stylesheet_link_tag "https://fonts.googleapis.com/css?family=Orbitron:400,500,700,900" %>

    <%# No Sprockets, no Bootstrap. `spa.css` is a separate entrypoint from
        `tailwind.css` because this document needs Tailwind's preflight, which
        the shared one omits to avoid disturbing Bootstrap 3. %>
    <%= vite_client_tag %>
    <%= vite_stylesheet_tag "spa.css" %>
    <%= vite_typescript_tag "frontend" %>

    <%# Api::BaseController verifies this token on cookie-authenticated
        mutations; axiosClient reads it from here. %>
    <%= csrf_meta_tags %>
  </head>
  <body>
    <div id="spa"></div>
  </body>
</html>
