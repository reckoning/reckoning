<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title %></title>

    <link rel="shortcut icon" type="image/png" href="<%= asset_url("favicon.png") %>">

    <%# The icon set the server-rendered screens use, from the same kit —
        the CSP already allows its hosts for the other layout. %>
    <script src="https://kit.fontawesome.com/80d0ee6c6c.js" crossorigin="anonymous"></script>

    <%# The brand face, same as the server-rendered layout. %>
    <%= stylesheet_link_tag "https://fonts.googleapis.com/css?family=Orbitron:400,500,700,900" %>

    <%# No Sprockets, no Bootstrap. `spa.css` is a separate entrypoint from
        `tailwind.css` because this document needs Tailwind's preflight, which
        the shared one omits to avoid disturbing Bootstrap 3. %>
    <%= vite_client_tag %>
    <%= vite_stylesheet_tag "spa.css", data: {turbo_track: "reload"} %>
    <%= vite_typescript_tag "frontend", data: {turbo_track: "reload"} %>

    <%= appsignal_meta_tags %>

    <%# Api::BaseController verifies this token on cookie-authenticated
        mutations; axiosClient reads it from here. %>
    <%= csrf_meta_tags %>
  </head>
  <body>
    <%# What is left of the server-rendered app redirects here when it refuses
        a request — an expired trial, a screen an account may not have — and
        the reason travels in the flash. Without this the SPA would answer a
        refusal with a dashboard and no explanation. %>
    <div
      id="spa"
      data-flash-error="<%= flash[:error] || flash[:alert] %>"
      data-flash-success="<%= flash[:success] || flash[:notice] %>"
    ></div>
  </body>
</html>
