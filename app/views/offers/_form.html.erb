<%= form_for offer, html: { id: "offer-form" } do |form| %>
  <div class="row">
    <div class="col-xs-12 col-md-6">
      <div class="form-group selectize <%= form_error?(offer, :project_id) %>">
        <select class="js-selectize" name="offer[project_id]" id="offer_project_id" placeholder="<%= I18n.t(:"helpers.prompt.offer.project_id") %>">
          <option></option>
          <% projects.each do |project| %>
            <option value="<%= project.id %>"<%= ' selected'.html_safe if project.id == @offer.project_id %> data-data="<%= project.to_json %>">
              <%= project.name_with_customer %>
            </option>
          <% end %>
        </select>
        <%= form_errors offer, :project_id %>
      </div>
    </div>
    <div class="col-xs-12 col-md-6">
      <div class="form-group <%= form_error?(offer, :date) %>">
        <div class="input-group datepicker" data-controller="datepicker">
          <%= form.label :date, class: "input-group-addon" %>
          <%= form.date_field :date, class: "form-control", "data-value" => form.object.date %>
          <span class="input-group-btn">
            <button class="btn btn-default" type="button">
              <i class="fa fa-calendar"></i>
            </button>
          </span>
        </div>
        <%= form_errors offer, :date, "input-group-btn-feedback" %>
      </div>
    </div>
  </div>
  <div class="row">
    <div class="col-xs-12 col-md-4 form-group <%= form_error?(offer, :ref) %>">
      <div class="input-group">
        <%= form.label :ref, class: "input-group-addon" %>
        <%= form.text_field :ref, value: (offer.ref_number unless offer.ref.blank?), class: "form-control" %>
      </div>
      <%= form_errors offer, :ref %>
    </div>
  </div>
  <div class="row">
    <div class="col-xs-12 col-md-6">
      <div class="form-group <%= form_error?(form.object, :description) %>">
        <%= form.label :description %>
        <%= form.text_area :description, placeholder: I18n.t(:"helpers.placeholder.offer.description"), rows: 6, class: "form-control" %>
        <%= form_errors form.object, :description %>
      </div>
    </div>
  </div>

  <fieldset>
    <legend>
      Positionen:
    </legend>

    <div id="positions" data-position-fields="<%= position_fields(form) %>">
      <%= form.fields_for :positions, offer.positions.order(description: :asc) do |builder| %>
        <%= render "position_fields", fields: builder %>
      <% end %>
    </div>

    <div class="btn-group-responsive pull-right">
      <%= link_to_add_fields form, :positions, name: I18n.t(:"actions.add"), class: "btn btn-default", target: "#positions" do %>
        <i class="fa fa-plus"></i>
        <%= I18n.t(:"actions.add_position") %>
      <% end %>
    </div>
  </fieldset>

  <%= render "shared/forms/submit", path: offers_path %>
<% end %>


<div class="modal fade" id="add-positions-modal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <button class="close" type="button" data-dismiss="modal" aria-hidden="true">
          &times;
        </button>
        <h3 class="modal-title">
          <%= I18n.t(:"labels.modals.title.positions") %>
        </h3>
      </div>
      <div class="modal-body">
        <form id="add-positions" onsubmit="App.offer.addPositions($(this)); return false;"></form>
      </div>
      <div class="modal-footer">
        <button class="btn btn-default" type="button" data-select-all>
          <i class="fa fa-check-square-o"></i>
        </button>
        <button class="btn btn-default" type="button" data-dismiss="modal">
          <%= I18n.t(:"actions.close") %>
        </button>
        <button class="btn btn-primary" form="add-positions" data-loading-text="<%= I18n.t(:"actions.loading") %>">
          <%= I18n.t(:"actions.add") %>
        </button>
      </div>
    </div>
  </div>
</div>
