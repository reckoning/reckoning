<% content_for :title do %>
  <%= I18n.t(:"meta.title.offer.show", offer_ref: offer.ref_number) %>
<% end %>

<div class="row" id="offer" data-id="<%= offer.id %>">

  <div class="col-xs-12 col-md-12">
    <div class="row">
      <div class="col-xs-12 col-md-8">
        <h1>
          <%= I18n.t(:"headlines.offer.show", offer_ref: offer.ref_number) %>
        </h1>
      </div>

      <div class="col-xs-12 col-md-4">
        <div class="btn-group btn-group-responsive pull-right resource-nav">
          <%= link_to I18n.t(:"nav.subnav.back"), back_path(offers_path), class: "btn btn-default" %>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-xs-12 col-md-8">
        <%= render "preview" %>
      </div>

      <div class="col-xs-12 col-md-4 side-nav">
        <div class="row">
          <div class="col-xs-12 col-md-12">
            <div class="panel panel-default">
              <div class="panel-heading">
                <div class="panel-title">
                  <strong>
                    <%= I18n.t(:"labels.panels.title.downloads") %>
                  </strong>
                </div>
              </div>
              <div class="list-group">
                <%= link_to pdf_offer_path(offer, offer.offer_file), target: "_blank", class: "save-offer list-group-item" do %>
                  <i class="fa fa-download"></i>
                  <%= I18n.t(:"actions.download_offer") %>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <br>

        <div class="row">
          <div class="col-xs-12 col-md-12">
            <%= render "show_actions" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
