<%= form_for test_mail, url: send_test_mail_invoice_path(invoice), method: :post, html: { id: "test_mail-form" } do |form| %>
  <div class="panel panel-default">
    <div class="panel-heading">
      <div class="panel-title">
        <strong>
          <%= I18n.t(:"labels.panels.title.test_mail") %>
        </strong>
      </div>
    </div>
    <div class="panel-body">
      <div class="form-group <%= form_error?(test_mail, :email) %>">
        <div class="input-group">
          <div class="input-group-fields">
            <%= form.email_field :email, placeholder: I18n.t(:"helpers.placeholder.test_mail.email"), class: "form-control" %>
            <%= form_errors test_mail, :email %>
          </div>
          <span class="input-group-btn">
            <button class="btn btn-primary">
              <%= I18n.t(:"actions.send") %>
            </button>
          </span>
        </div>
      </div>
    </div>
  </div>
<% end %>
