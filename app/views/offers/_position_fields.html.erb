<div class="row fields">
  <div class="col-xs-12 col-md-5">
    <div class="form-group <%= form_error?(fields.object, :description) %>">
      <%= fields.text_field :description, placeholder: I18n.t(:"helpers.placeholder.position.description"), class: "form-control" %>
      <%= form_errors fields.object, :description %>
    </div>
  </div>

  <div class="col-xs-12 col-md-2 form-group">
    <div class="input-group">
      <%= fields.label :rate, class: "input-group-addon" %>
      <%= fields.text_field :rate, placeholder: I18n.t(:"helpers.placeholder.position.rate"), class: "form-control offer-position-rate", value: (fields.object.attributes["rate"] || (@offer.project.rate if @offer.project.present? && fields.object.attributes["hours"])) %>
    </div>
  </div>
  <div class="col-xs-12 col-md-2 form-group">
    <div class="input-group <%= form_error?(fields.object, :hours) %>">
      <%= fields.label :hours, class: "input-group-addon" %>
      <%= fields.text_field :hours, placeholder: I18n.t(:"helpers.placeholder.position.hours"), class: "form-control offer-position-hours" %>
    </div>
    <%= form_errors fields.object, :hours %>
  </div>
  <div class="col-xs-12 col-md-2 form-group">
    <div class="input-group <%= form_error?(fields.object, :value) %>">
      <%= fields.text_field :value, placeholder: I18n.t(:"helpers.placeholder.position.value"), class: "form-control offer-position-value" %>
      <%= fields.label :value, class: "input-group-addon" %>
    </div>
    <%= form_errors fields.object, :value %>
  </div>

  <div class="col-xs-12 col-md-1">
    <div class="btn-group-responsive form-group pull-right">
      <%= link_to_delete_fields fields, name: I18n.t(:"actions.delete"), class: "btn btn-danger" do %>
        <i class="fa fa-trash"></i>
      <% end %>
    </div>
  </div>

  <div class="clearfix"></div>
  <div class="col-xs-12 visible-sm visible-xs">
    <hr>
  </div>
</div>
