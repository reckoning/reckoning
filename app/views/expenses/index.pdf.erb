<div id="pdf-body">
  <% if resource.gwg.present? %>
    <h2><%= I18n.t("pdf.expenses.headlines.gwg") %></h2>
    <table class="table table-condensed">
      <thead>
        <th colspan="3">
          <%= I18n.t("filter.expense_type.gwg") %>
        </th>
      </thead>
      <tbody>
        <% resource.gwg.each do |expense| %>
          <tr>
            <td><%= I18n.l expense.date %></td>
            <td><%= expense.description %></td>
            <td class="align-right"><%= number_to_currency expense.usable_value %></td>
          </tr>
        <% end %>
        <tr class="sum border">
          <td colspan="3">
            <%= I18n.t("labels.defaults.sum") %>
            <b><%= number_to_currency resource.gwg.sum(&:usable_value) %></b>
          </td>
        </tr>
      </tbody>
    </table>

    <div class="sum">
      <%= I18n.t("pdf.expenses.footer.gwg") %>
      <u style="float: right;">
        <b><%= number_to_currency resource.gwg.sum(&:usable_value) %></b>
      </u>
    </div>

    <div class="alwaysbreak"></div>
  <% end %>

  <% if resource.telecommunication.present? %>
    <h2><%= I18n.t("pdf.expenses.headlines.telecommunication") %></h2>
    <% resource.telecommunication.group_by(&:description).each do |description, expenses| %>
      <table class="table table-condensed">
        <thead>
          <th colspan="2"><%= description %></th>
        </thead>
        <tbody>
          <% expenses.each do |expense| %>
            <tr>
              <td><%= I18n.l expense.date %></td>
              <td class="align-right"><%= number_to_currency expense.usable_value %></td>
            </tr>
          <% end %>
          <tr class="sum border">
            <td colspan="3">
              <%= I18n.t("labels.defaults.sum") %>
              <b><%= number_to_currency expenses.sum(&:value) %></b>
            </td>
          </tr>
          <% private_use_percent = expenses.sum(&:private_use_percent) / expenses.size %>
          <% if private_use_percent != 0 %>
            <tr class="sum">
              <td colspan="3">
                <%= I18n.t("pdf.expenses.business_amount", percent: 100 - private_use_percent) %>
                <b><%= number_to_currency expenses.sum(&:usable_value) %></b>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
    <div class="sum">
      <%= I18n.t("pdf.expenses.footer.telecommunication") %>
      <u style="float: right;">
        <b><%= number_to_currency resource.telecommunication.sum(&:usable_value) %></b>
      </u>
    </div>

    <div class="alwaysbreak"></div>
  <% end %>

  <% if resource.insurances.present? %>
    <h2><%= I18n.t("pdf.expenses.headlines.insurances") %></h2>
    <% resource.insurances.group_by(&:description).each do |description, expenses| %>
      <table class="table table-condensed">
        <thead>
          <th colspan="2"><%= description %></th>
        </thead>
        <tbody>
          <% expenses.each do |expense| %>
            <tr>
              <td><%= I18n.l expense.date %></td>
              <td class="align-right"><%= number_to_currency expense.usable_value %></td>
            </tr>
          <% end %>
          <tr class="sum border">
            <td colspan="3">
              <%= I18n.t("labels.defaults.sum") %>
              <b><%= number_to_currency expenses.sum(&:value) %></b>
            </td>
          </tr>
        </tbody>
      </table>
    <% end %>

    <div class="sum">
      <%= I18n.t("pdf.expenses.footer.insurances") %>
      <u style="float: right;">
        <b><%= number_to_currency resource.insurances.sum(&:usable_value) %></b>
      </u>
    </div>

    <div class="alwaysbreak"></div>
  <% end %>

  <% if resource.non_cash_contribution.present? %>
    <h2><%= I18n.t("pdf.expenses.headlines.non_cash_contribution") %></h2>
    <% resource.non_cash_contribution.group_by(&:description).each do |description, expenses| %>
      <table class="table table-condensed">
        <thead>
          <th colspan="2"><%= description %></th>
        </thead>
        <tbody>
          <% expenses.each do |expense| %>
            <tr>
              <td><%= I18n.l expense.date %></td>
              <td class="align-right"><%= number_to_currency expense.usable_value %></td>
            </tr>
          <% end %>
          <tr class="sum border">
            <td colspan="3">
              <%= I18n.t("labels.defaults.sum") %>
              <b><%= number_to_currency expenses.sum(&:value) %></b>
            </td>
          </tr>
        </tbody>
      </table>
    <% end %>

    <div class="sum">
      <%= I18n.t("pdf.expenses.footer.non_cash_contribution") %>
      <u style="float: right;">
        <b><%= number_to_currency resource.non_cash_contribution.sum(&:usable_value) %></b>
      </u>
    </div>

    <div class="alwaysbreak"></div>
  <% end %>

  <% if resource.travel_costs.present? %>
    <h2><%= I18n.t("pdf.expenses.headlines.travel_costs") %></h2>
    <table class="table table-condensed">
      <thead>
        <th colspan="2"></th>
      </thead>
      <tbody>
        <% resource.travel_costs.each do |expense| %>
          <tr>
            <td><%= expense.description %></td>
            <td class="align-right" style="min-width: 100px;"><%= number_to_currency expense.usable_value %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="sum">
      <%= I18n.t("pdf.expenses.footer.travel_costs") %>
      <u style="float: right;">
        <b><%= number_to_currency resource.travel_costs.sum(&:usable_value) %></b>
      </u>
    </div>

    <div class="alwaysbreak"></div>
  <% end %>

  <% if resource.business_expenses.present? %>
    <h2><%= I18n.t("pdf.expenses.headlines.business_expenses") %></h2>
    <table class="table table-condensed">
      <thead>
        <th colspan="2"></th>
      </thead>
      <tbody>
        <% resource.business_expenses.each do |expense| %>
          <tr>
            <td><%= expense.description %></td>
            <td class="align-right" style="min-width: 100px;"><%= number_to_currency expense.usable_value %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="sum">
      <%= I18n.t("pdf.expenses.footer.business_expenses") %>
      <u style="float: right;">
        <b><%= number_to_currency resource.business_expenses.sum(&:usable_value) %></b>
      </u>
    </div>

    <div class="alwaysbreak"></div>
  <% end %>

  <% if resource.training.present? %>
    <h2><%= I18n.t("pdf.expenses.headlines.training") %></h2>
    <table class="table table-condensed">
      <thead>
        <th colspan="2"></th>
      </thead>
      <tbody>
        <% resource.training.each do |expense| %>
          <tr>
            <td><%= expense.description %></td>
            <td class="align-right" style="min-width: 100px;"><%= number_to_currency expense.usable_value %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="sum">
      <%= I18n.t("pdf.expenses.footer.training") %>
      <u style="float: right;">
        <b><%= number_to_currency resource.training.sum(&:usable_value) %></b>
      </u>
    </div>

    <div class="alwaysbreak"></div>
  <% end %>

  <% if resource.account.office_space.present? && resource.home_office.present? %>
    <h2>
      <%= I18n.t("pdf.expenses.headlines.home_office") %>
      <div class="subline">
        <%= I18n.t("pdf.expenses.sublines.home_office", office_space: resource.account.office_space, deductible_office_space: resource.account.deductible_office_space) %>
      </div>
    </h2>

    <% resource.home_office.group_by(&:description).each do |description, expenses| %>
      <table class="table table-condensed">
        <thead>
          <th colspan="2"><%= description %></th>
        </thead>
        <tbody>
          <% expenses.each do |expense| %>
            <tr>
              <td><%= I18n.l expense.date %></td>
              <td class="align-right"><%= number_to_currency expense.value %></td>
            </tr>
          <% end %>
          <tr class="sum border">
            <td colspan="3">
              <%= I18n.t("labels.defaults.sum") %>
              <b><%= number_to_currency expenses.sum(&:value) %></b>
            </td>
          </tr>
          <tr class="sum">
            <td colspan="3">
              <%= I18n.t("pdf.expenses.office_space_amount", percent: resource.account.deductible_office_percent) %>
              <b><%= number_to_currency expenses.sum(&:usable_value) %></b>
            </td>
          </tr>
        </tbody>
      </table>
    <% end %>
    <div class="sum">
      <%= I18n.t("pdf.expenses.footer.home_office") %>
      <u style="float: right;">
        <b><%= number_to_currency resource.home_office.sum(&:usable_value) %></b>
      </u>
    </div>

    <div class="alwaysbreak"></div>
  <% end %>

  <% if resource.current.present? || resource.misc.present? || resource.licenses.present? %>
    <h2><%= I18n.t("pdf.expenses.headlines.other") %></h2>
    <% if resource.current.present? %>
      <% resource.current.group_by(&:description).each do |description, expenses| %>
        <table class="table table-condensed">
          <thead>
            <th colspan="2"><%= description %></th>
          </thead>
          <tbody>
            <% expenses.each do |expense| %>
              <tr>
                <td><%= I18n.l expense.date %></td>
                <td class="align-right"><%= number_to_currency expense.usable_value %></td>
              </tr>
            <% end %>
            <tr class="sum border">
              <td colspan="3">
                <%= I18n.t("labels.defaults.sum") %>
                <b><%= number_to_currency expenses.sum(&:value) %></b>
              </td>
            </tr>
            <% private_use_percent = expenses.sum(&:private_use_percent) / expenses.size %>
            <% if private_use_percent != 0 %>
              <tr class="sum">
                <td colspan="3">
                  <%= I18n.t("pdf.expenses.business_amount", percent: 100 - private_use_percent) %>
                  <b><%= number_to_currency expenses.sum(&:usable_value) %></b>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    <% end %>

    <% if resource.misc.present? %>
      <table class="table table-condensed">
        <thead>
          <th colspan="3"><%= I18n.t("filter.expense_type.misc") %></th>
        </thead>
        <tbody>
          <% resource.misc.each do |expense| %>
            <tr>
              <td><%= I18n.l expense.date %></td>
              <td><%= expense.description %></td>
              <td class="align-right"><%= number_to_currency expense.usable_value %></td>
            </tr>
          <% end %>
          <tr class="sum border">
            <td colspan="3">
              <%= I18n.t("labels.defaults.sum") %>
              <b><%= number_to_currency resource.misc.sum(&:usable_value) %></b>
            </td>
          </tr>
        </tbody>
      </table>
    <% end %>

    <% if resource.licenses.present? %>
      <table class="table table-condensed">
        <thead>
          <th colspan="3"><%= I18n.t("filter.expense_type.licenses") %></th>
        </thead>
        <tbody>
          <% resource.licenses.each do |expense| %>
            <tr>
              <td><%= I18n.l expense.date %></td>
              <td><%= expense.description %></td>
              <td class="align-right"><%= number_to_currency expense.usable_value %></td>
            </tr>
          <% end %>
          <tr class="sum border">
            <td colspan="3">
              <%= I18n.t("labels.defaults.sum") %>
              <b><%= number_to_currency resource.licenses.sum(&:usable_value) %></b>
            </td>
          </tr>
        </tbody>
      </table>
    <% end %>

    <div class="sum">
      <%= I18n.t("pdf.expenses.footer.other") %>
      <u style="float: right;">
        <b><%= number_to_currency(resource.current.sum(&:usable_value) + resource.misc.sum(&:usable_value) + resource.licenses.sum(&:usable_value)) %></b>
      </u>
    </div>
  <% end %>
</div>
