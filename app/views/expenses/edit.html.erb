<% content_for :title do %>
  <%= I18n.t(:"meta.title.expense.edit") %>
<% end %>

<div class="row" id="edit-expense">

  <div class="col-xs-12 col-md-12">

    <div class="row">
      <div class="col-xs-12 col-md-8">
        <h1><%= I18n.t(:"headlines.expense.edit") %></h1>
      </div>

      <div class="col-xs-12 col-md-4">
        <div class="btn-group btn-group-responsive pull-right resource-nav">
          <%= link_to I18n.t(:"nav.subnav.back"), "#{expenses_path(stored_params(:index))}#expense-#{expense.id}", class: "btn btn-default" %>
          <a class="btn btn-warning" href="<%= new_expense_path(expense.to_prefill_params) %>">
            <i class="fa fa-copy"></i>
            <%= I18n.t(:"actions.copy") %>
          </a>
          <a class="btn btn-danger" href="<%= expense_path(expense) %>" data-redirect="<%= expenses_path %>" data-method="DELETE" data-notyConfirm="<%= I18n.t(:"messages.confirm.delete") %>">
            <i class="fa fa-trash"></i>
            <%= I18n.t(:"actions.delete") %>
          </a>
        </div>
      </div>
    </div>

    <%= render "form" %>
  </div>
</div>
