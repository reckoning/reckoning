<div class="list-group-item" id="expense-<%= expense.id %>" style="position: relative; padding-left: 44px;">
  <%= check_box_tag "expense_ids[]", expense.id, false, class: "rk-checkbox",
        id: "select-expense-#{expense.id}", "aria-label": I18n.t(:"expenses.bulk.select_row"),
        style: "position: absolute; left: 16px; top: 50%; transform: translateY(-50%); z-index: 2;",
        "data-bulk-select-target": "checkbox", "data-action": "change->bulk-select#refresh" %>
  <div class="row">
    <div class="col-xs-6 col-md-2">
      <% if expense.once? %>
        <%= I18n.l expense.date %>
      <% else %>
        <%= "#{Expense.human_enum_name(:interval, expense.interval)}: #{I18n.l(expense.started_at)} - #{(I18n.l(expense.ended_at) if expense.ended_at)}" %>
      <% end %>
    </div>
    <div class="col-xs-6 col-md-3 expense-description">
      <a href="<%= edit_expense_path(expense) %>" title="<%= I18n.t(:"actions.edit") %>">
        <b><%= expense.description %></b>
      </a>
    </div>
    <div class="col-xs-6 col-md-2">
      <%= I18n.t(:"filter.expense_type.#{expense.expense_type}") %>
    </div>
    <div class="col-xs-6 col-md-2">
      <%= number_to_currency expense.vat_value %>
    </div>
    <div class="col-xs-12 col-md-3">
      <% if expense.receipt.present? %>
        <i class="fa fa-file" title="<%= I18n.t(:"expenses.file_attached") %>"></i>
      <% elsif expense.needs_receipt? %>
        <i class="fa fa-file text-danger" title="<%= I18n.t(:"expenses.needs_receipt") %>"></i>
      <% end %>
      <div class="pull-right expense-price">
        <%= number_to_currency expense.usable_value %>
      </div>
    </div>
  </div>
</div>
