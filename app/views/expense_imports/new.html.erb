<% content_for :title do %>
  <%= I18n.t(:"meta.title.expense.import") %>
<% end %>

<div class="row" id="new-expense-import">

  <div class="col-xs-12 col-md-12">

    <div class="row">
      <div class="col-xs-12 col-md-8">
        <h1><%= I18n.t(:"headlines.expense.import") %></h1>
      </div>

      <div class="col-xs-12 col-md-4">
        <div class="btn-group-responsive pull-right resource-nav">
          <%= link_to I18n.t(:"nav.subnav.back"), expenses_path(stored_params(:index)), class: "btn btn-default" %>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-xs-12">
        <p>A CSV or Excel file can be used to import records. The first row should be the column name. The following columns are allowed.</p>

        <ul>
          <% Expense.columns.each do |column| %>
            <% if column.name.in? ["id", *Expense.accessible_attributes] %>
              <li>
                <strong><%= column.name %></strong>
                <%= "- #{column.type.to_s.titleize} type" %>
              </li>
            <% end %>
          <% end %>
        </ul>

        <p>
          If an <strong>id</strong> is supplied it will update the matching record instead of creating a new one.
        </p>
      </div>
    </div>

    <%= form_for @expense_import do |f| %>

      <% if @expense_import.errors.any? %>
        <div id="error_explanation">
          <h3>
            <%= pluralize(@expense_import.errors.count, "error") %>
            prohibited this import from completing:
          </h3>
          <ul>
            <% @expense_import.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= f.file_field :file %>

      <%= render "shared/forms/submit", path: expenses_path(stored_params(:index)) %>
    <% end %>
  </div>
</div>
