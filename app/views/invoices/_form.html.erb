<%= form_for invoice, html: { id: "invoice-form" } do |form| %>
  <div class="row">
    <div class="col-xs-12 col-md-4">
      <div class="form-group selectize <%= form_error?(invoice, :project_id) %>">
        <select class="js-selectize" data-controller="selectize" name="invoice[project_id]" id="invoice_project_id" placeholder="<%= I18n.t(:"helpers.prompt.invoice.project_id") %>">
          <option></option>
          <% projects.each do |project| %>
            <option value="<%= project.id %>"<%= ' selected'.html_safe if project.id == @invoice.project_id %> data-data="<%= project.to_json %>">
              <%= project.name_with_customer %>
            </option>
          <% end %>
        </select>
        <%= form_errors invoice, :project_id %>
      </div>
    </div>
    <div class="col-xs-12 col-md-4">
      <div class="form-group <%= form_error?(invoice, :date) %>">
        <div class="input-group datepicker" data-controller="datepicker">
          <%= form.label :date, class: "input-group-addon" %>
          <%= form.date_field :date, class: "form-control", "data-value" => form.object.date %>
          <span class="input-group-btn">
            <button class="btn btn-default" type="button">
              <i class="fa fa-calendar"></i>
            </button>
          </span>
        </div>
        <%= form_errors invoice, :date, "input-group-btn-feedback" %>
      </div>
    </div>
    <div class="col-xs-12 col-md-4">
      <div class="form-group <%= form_error?(invoice, :pay_date) %>">
        <div class="input-group datepicker" data-controller="datepicker">
          <%= form.label :pay_date, class: "input-group-addon" %>
          <%= form.date_field :pay_date, disabled: !form.object.paid?, class: "form-control", "data-value" => form.object.pay_date %>
          <span class="input-group-btn">
            <button class="btn btn-default" type="button" <%= "disabled".html_safe unless form.object.paid? %>>
              <i class="fa fa-calendar"></i>
            </button>
          </span>
        </div>
        <%= form_errors invoice, :pay_date, "input-group-btn-feedback" %>
      </div>
    </div>
  </div>
  <div class="row">
    <div class="col-xs-12 col-md-4 form-group <%= form_error?(invoice, :ref) %>">
      <div class="input-group">
        <%= form.label :ref, class: "input-group-addon" %>
        <%= form.text_field :ref, value: (invoice.ref_number unless invoice.ref.blank?), class: "form-control" %>
      </div>
      <%= form_errors invoice, :ref %>
    </div>
    <div class="col-xs-12 col-md-4 form-group">
      <div class="input-group datepicker" data-controller="datepicker">
        <%= form.label :payment_due_date, class: "input-group-addon" %>
        <%= form.date_field :payment_due_date, class: "form-control", "data-value" => form.object.payment_due_date %>
        <span class="input-group-btn">
          <button class="btn btn-default" type="button">
            <i class="fa fa-calendar"></i>
          </button>
        </span>
      </div>
    </div>
    <div class="col-xs-12 col-md-4 form-group">
      <div class="input-group datepicker" data-controller="datepicker">
        <%= form.label :delivery_date, class: "input-group-addon" %>
        <%= form.date_field :delivery_date, class: "form-control", "data-value" => form.object.delivery_date %>
        <span class="input-group-btn">
          <button class="btn btn-default" type="button">
            <i class="fa fa-calendar"></i>
          </button>
        </span>
      </div>
    </div>
  </div>

  <fieldset>
    <legend>
      Positionen:
    </legend>

    <div id="positions" data-timer-position-fields="<%= timer_position_fields(form) %>">
      <%= form.fields_for :positions, invoice.positions.order(description: :asc) do |builder| %>
        <% if builder.object.timer_ids.blank? %>
          <%= render "position_fields", fields: builder %>
        <% else %>
          <%= render "timer_position_fields", fields: builder %>
        <% end %>
      <% end %>
    </div>

    <div class="btn-group-responsive pull-right">
      <%= link_to_add_fields form, :positions, name: I18n.t(:"actions.add"), class: "btn btn-default", target: "#positions" do %>
        <i class="fa fa-plus"></i>
        <%= I18n.t(:"actions.add_position") %>
      <% end %>
      <button class="ladda-button btn btn-default" type="button" onclick="App.Invoice.loadPositions($(this)); return false;" data-style="expand-right" data-spinner-color="#333">
        <i class="fa fa-plus"></i>
        <%= I18n.t(:"actions.generate_position") %>
      </button>
    </div>
  </fieldset>

  <%= render "shared/forms/submit", path: invoices_path %>
<% end %>


<div class="modal fade" id="add-positions-modal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <button class="close" type="button" data-dismiss="modal" aria-hidden="true">
          &times;
        </button>
        <h3 class="modal-title">
          <%= I18n.t(:"labels.modals.title.positions") %>
        </h3>
      </div>
      <div class="modal-body">
        <form id="add-positions" onsubmit="App.Invoice.addPositions($(this)); return false;"></form>
      </div>
      <div class="modal-footer">
        <button class="btn btn-default" type="button" data-select-all>
          <i class="fa fa-check-square-o"></i>
        </button>
        <button class="btn btn-default" type="button" data-dismiss="modal">
          <%= I18n.t(:"actions.close") %>
        </button>
        <button class="btn btn-primary" form="add-positions" data-loading-text="<%= I18n.t(:"actions.loading") %>">
          <%= I18n.t(:"actions.add") %>
        </button>
      </div>
    </div>
  </div>
</div>
