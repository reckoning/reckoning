<div class="panel panel-default">
  <div class="panel-heading">
    <div class="panel-title">
      <strong>
        <%= I18n.t(:"labels.panels.title.default") %>
      </strong>
    </div>
  </div>
  <div class="list-group">
    <% if can? :update, invoice %>
      <a class="list-group-item" href="<%= edit_invoice_path(invoice) %>">
        <i class="fa fa-edit"></i>
        <%= I18n.t(:"actions.edit") %>
      </a>
    <% end %>

    <% if invoice.send_via_mail? %>
      <%= link_to send_mail_invoice_path(invoice), data: { turbo_method: :put }, class: "list-group-item" do %>
        <i class="fa fa-paper-plane"></i>
        <%= I18n.t(:"actions.send_invoice") %>
      <% end %>
    <% end %>
    <a class="list-group-item" href="<%= invoice_path(invoice) %>" data-method="DELETE" data-notyConfirm="<%= I18n.t(:"messages.confirm.delete") %>">
      <i class="fa fa-trash"></i>
      <%= I18n.t(:"actions.delete") %>
    </a>
  </div>
</div>
