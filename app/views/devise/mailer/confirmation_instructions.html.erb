<p>
  <%= I18n.t(:"devise.mailer.confirmation_instructions.content.welcome", email: @resource.email) %>
</p>
<p><%= I18n.t(:"devise.mailer.confirmation_instructions.content.confirm_text") %></p>
<p><%= link_to I18n.t(:"devise.mailer.confirmation_instructions.content.confirm_link"), confirmation_url(@resource, confirmation_token: @token) %></p>
<% if @resource.created_via_admin? %>
  <p><%= I18n.t(:"devise.mailer.confirmation_instructions.content.created_via_admin_text") %></p>
<% end %>
