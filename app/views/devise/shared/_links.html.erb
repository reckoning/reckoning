<div class="panel panel-default">
  <div class="panel-heading">
    <div class="panel-title">
      <strong>
        <%= I18n.t(:"panels.title.default") %>
      </strong>
    </div>
  </div>
  <div class="list-group">
    <% unless %w[sessions].include?(controller_name) %>
      <%= link_to I18n.t(:"actions.sign_in"), new_session_path(resource_name), class: "list-group-item" %>
    <% end %>
    <% unless %w[passwords registrations].include?(controller_name) %>
      <%= link_to I18n.t(:"actions.forgot_password"), new_password_path(resource_name), class: "list-group-item" %>
    <% end %>
    <% unless %w[confirmations registrations].include?(controller_name) %>
      <%= link_to I18n.t(:"actions.confirm"), new_confirmation_path(resource_name), class: "list-group-item" %>
    <% end %>
    <% unless %w[unlocks registrations].include?(controller_name) %>
      <%= link_to I18n.t(:"actions.unlock"), new_unlock_path(resource_name), class: "list-group-item" %>
    <% end %>
  </div>
</div>
