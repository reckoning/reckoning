<% content_for :title do %>
  <%= I18n.t(:"meta.title.backend.user.index") %>
<% end %>
<div class="row" id="users">
  <div class="col-xs-12 col-md-12">

    <%# Tailwind 4 probe — Phase 2 of frontend migration. Renders an
        emerald badge if Tailwind is loading; falls back to plain text
        if not. Remove once Tailwind is exercised elsewhere in the app. %>
    <div class="inline-block rounded bg-emerald-500 px-2 py-1 text-xs font-medium text-white">
      Tailwind ok
    </div>

    <div class="row">
      <div class="col-xs-12 col-md-8">
        <h1>
          <%= I18n.t(:"headlines.backend.user.index") %>
        </h1>
      </div>

      <div class="col-xs-12 col-md-4">
        <div class="btn-group pull-right resource-nav">
          <%= link_to I18n.t(:"nav.subnav.new_user"), new_backend_user_path, class: "btn btn-default" %>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-xs-12 col-md-6">
        <div class="pull-right">
          <%= paginate @users %>
        </div>
      </div>
    </div>

    <%= render partial: "backend/users/table", "@users": @users %>

    <div class="row">
      <div class="col-xs-12 col-md-6">
        <div class="pull-right">
          <%= paginate @users %>
        </div>
      </div>
    </div>
  </div>
</div>
