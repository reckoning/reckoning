<tr>
  <td>
    <%= user.id %>
  </td>
  <td>
    <%= user.email %>
  </td>
  <td>
    <%= last_user_logged_in(user) %>
  </td>
  <td>
    <%= I18n.t(:"activerecord.attributes.user.created_at", time: time_ago_in_words(user.created_at)) %>
  </td>
  <td>
    <%= t user.admin?.to_s %>
  </td>
  <td>
    <div class="btn-group">
      <%= link_to edit_backend_user_path(user), title: I18n.t(:"actions.edit"), class: "btn btn-default btn-sm" do %>
        <i class="fa fa-edit"></i>
      <% end %>
      <% unless user.confirmed? %>
        <%= link_to send_welcome_backend_user_path(user), title: I18n.t(:"actions.send_welcome"), class: "btn btn-default btn-sm", data: { turbo_method: :put } do %>
          <i class="fa fa-send"></i>
        <% end %>
      <% end %>
      <a class="btn btn-danger btn-sm" href="<%= backend_user_path(user) %>" title="<%= I18n.t(:"actions.delete") %>" data-method="DELETE" data-notyConfirm="<%= I18n.t(:"messages.confirm.delete") %>">
        <i class="fa fa-trash"></i>
      </a>
    </div>
  </td>
</tr>
