- content_for :title do
  = I18n.t(:"meta.title.backend.user.index")
.row#users
  .col-xs-12.col-md-12

    -# Tailwind 4 probe — Phase 2 of frontend migration. Renders an
    -# emerald badge if Tailwind is loading; falls back to plain text
    -# if not. Remove once Tailwind is exercised elsewhere in the app.
    %div.inline-block.rounded.bg-emerald-500.px-2.py-1.text-xs.font-medium.text-white
      Tailwind ok

    .row
      .col-xs-12.col-md-8
        %h1
          = I18n.t(:"headlines.backend.user.index")

      .col-xs-12.col-md-4
        .btn-group.pull-right.resource-nav
          = link_to I18n.t(:"nav.subnav.new_user"), new_backend_user_path, class: "btn btn-default"

    .row
      .col-xs-12.col-md-6
        .pull-right
          = paginate @users

    = render partial: "backend/users/table", :@users => @users

    .row
      .col-xs-12.col-md-6
        .pull-right
          = paginate @users
