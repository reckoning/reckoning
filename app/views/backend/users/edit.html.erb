<% content_for :title do %>
  <%= I18n.t(:"meta.title.backend.user.edit") %>
<% end %>
<div class="row" id="user-edit">
  <div class="col-xs-12 col-md-12">

    <div class="row">
      <div class="col-xs-12 col-md-8">
        <h1>
          <%= I18n.t(:"headlines.backend.user.edit", user: user.email) %>
        </h1>
      </div>

      <div class="col-xs-12 col-md-4">
        <div class="btn-group pull-right resource-nav">
          <%= link_to I18n.t(:"nav.subnav.back"), backend_users_path, class: "btn btn-default" %>
        </div>
      </div>
    </div>

    <%= render "form" %>
  </div>
</div>
