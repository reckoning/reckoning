<%= form_for [:backend, user] do |form| %>
  <div class="row">
    <div class="col-xs-12 col-md-6 form-group <%= form_error?(user, :email) %>">
      <%= form.text_field :email, placeholder: I18n.t(:"helpers.placeholder.user.email"), class: "form-control" %>
      <small>
        <%= form_errors user, :email %>
      </small>
    </div>
  </div>
  <div class="row">
    <div class="col-xs-6 col-md-3 form-group">
      <div class="checkbox">
        <%= form.label :admin do %>
          <%= form.check_box :admin %>
          <%= I18n.t(:"activerecord.attributes.user.admin") %>
        <% end %>
      </div>
    </div>
  </div>


  <%= render "shared/forms/submit", path: backend_users_path %>
<% end %>
