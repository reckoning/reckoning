<% content_for :title do %>
  <%= I18n.t(:"meta.title.backend.account.edit") %>
<% end %>
<div class="row" id="account-edit">
  <div class="col-xs-12 col-md-12">
    <div class="row">
      <div class="col-xs-12 col-md-8">
        <h1>
          <%= I18n.t(:"headlines.backend.account.edit", account: account.name) %>
        </h1>
      </div>

      <div class="col-xs-12 col-md-4">
        <div class="btn-group pull-right resource-nav">
          <%= link_to I18n.t(:"nav.subnav.back"), backend_accounts_path, class: "btn btn-default" %>
        </div>
      </div>
    </div>

    <%= form_for [:backend, account] do |form| %>
      <div class="row">
        <div class="col-xs-12 col-md-6 form-group <%= form_error?(account, :name) %>">
          <%= form.label :name %>
          <%= form.text_field :name, placeholder: I18n.t(:"helpers.placeholder.account.name"), class: "form-control" %>
          <small>
            <%= form_errors account, :name %>
          </small>
        </div>
        <div class="col-xs-12">
          <div class="checkbox">
            <%= form.check_box :feature_expenses %>
            <label for="account_feature_expenses">
              <%= I18n.t(:"helpers.label.account.feature_expenses") %>
            </label>
          </div>
        </div>
        <div class="col-xs-12">
          <div class="checkbox">
            <%= form.check_box :feature_logbook %>
            <label for="account_feature_logbook">
              <%= I18n.t(:"helpers.label.account.feature_logbook") %>
            </label>
          </div>
        </div>
      </div>

      <%= render "shared/forms/submit", path: backend_accounts_path %>
    <% end %>
  </div>
</div>
