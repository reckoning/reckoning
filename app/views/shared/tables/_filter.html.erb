<% translateable ||= false %>
<% current_filter = filter_params.fetch(name, nil) %>
<div class="dropdown btn-group flex">
  <% if current_filter %>
    <% reset_params = filter_params.dup %>
    <% reset_params.delete(name) %>
    <a class="btn btn-danger" href="<%= url_for(reset_params) %>" title="<%= I18n.t(:"filter.delete") %>">
      <i class="fa fa-times"></i>
    </a>
  <% end %>
  <a class="btn btn-default dropdown-toggle" href="#" data-toggle="dropdown">
    <%= I18n.t("filter.#{resource}_#{name}.label") %>
    <% if current_filter %>
      <%
        if translateable
          current_value = if translateable.is_a?(String)
            I18n.t(translateable)[current_filter.to_i]
          else
            I18n.t("filter.#{resource}_#{name}.#{current_filter}")
          end
        else
          current_value = current_filter
        end
      %>
      <b>
        <%= current_value %>
      </b>
    <% end %>
    <span class="caret"></span>
  </a>
  <ul class="dropdown-menu" role="menu">
    <% filters.each do |filter| %>
      <%
        if filter.is_a?(Hash)
          filter = OpenStruct.new filter
          value = filter.name
        end
        value ||= filter.to_s
      %>
      <li class="<%= "active" if current_filter == value %>">
        <%
          link = filter.link if defined?(filter.link)
          link ||= I18n.t(:"filter.#{resource}_#{name}.#{value}")
        %>
        <%= link_to link, plumb(name.to_s => value) %>
      </li>
    <% end %>
  </ul>
</div>
