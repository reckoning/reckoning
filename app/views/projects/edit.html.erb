<% content_for :title do %>
  <%= I18n.t(:"meta.title.project.edit") %>
<% end %>
<div class="row" id="edit-project">
  <div class="col-xs-12 col-md-12">
    <div class="row">
      <div class="col-xs-12 col-md-8">
        <h1><%= I18n.t(:"headlines.project.edit") %></h1>
      </div>
      <div class="col-xs-12 col-md-4">
        <div class="btn-group btn-group-justified-responsive pull-right resource-nav">
          <%= link_to I18n.t(:"nav.subnav.back"), :back, class: "btn btn-default" %>
          <a class="btn btn-danger" href="<%= v1_project_url(project) %>" data-redirect="<%= projects_path %>" data-method="DELETE" data-notyConfirm="<%= I18n.t(:"messages.confirm.delete") %>">
            <i class="fa fa-trash"></i>
            <%= I18n.t(:"actions.delete") %>
          </a>
        </div>
      </div>
    </div>
    <%= render "form" %>
  </div>
</div>
