<% context ||= "info" %>
<%# The Vue timers calendar. It stays an island rather than an SPA page:
    the screen around it is still server-rendered until the offers and
    invoices panels move in B6 and B7. Localized strings round-trip through
    `data-island-props` so the island does not consume i18n-js client-side.
    The seven day-short labels are Monday-first to match ISO weeks. %>
<div
  id="timers-calendar"
  class="timers-calendar"
  data-island="timers-calendar"
  data-island-props="<%= {
    projectId: project.id,
    locale: I18n.locale.to_s,
    monthLabels: (1..12).map { |m| I18n.l(Date.new(2024, m, 1), format: :month) },
    labels: {
      weekDays: I18n.t('labels.defaults.week_days'),
      today: I18n.t('actions.today'),
      addTimer: I18n.t('actions.add_timer'),
      dayShort: (0..6).map { |i| I18n.l(Date.new(2024, 1, 1) + i, format: :day_short) },
    },
  }.to_json %>"
></div>
