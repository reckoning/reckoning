<%= form_for account, url: account_path do |form| %>
  <input name="hash" value="" type="hidden">
  <div class="row">
    <div class="col-xs-12 col-sm-6 col-md-3 form-group">
      <%= form.label :tax %>
      <div class="input-group <%= form_error?(form.object, :tax) %>">
        <%= form.text_field :tax, class: "form-control text-right" %>
        <small><%= form_errors form.object, :tax %></small>
        <span class="input-group-addon">%</span>
      </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-3 form-group">
      <%= form.label :provision %>
      <div class="input-group <%= form_error?(form.object, :provision) %>">
        <%= form.text_field :provision, class: "form-control text-right" %>
        <small><%= form_errors form.object, :provision %></small>
        <span class="input-group-addon">%</span>
      </div>
    </div>
    <div class="col-xs-12 col-md-6 form-group <%= form_error?(form.object, :vat_id) %>">
      <%= form.label :vat_id %>
      <%= form.text_field :vat_id, placeholder: I18n.t(:"helpers.placeholder.account.vat_id"), class: "form-control" %>
      <small><%= form_errors form.object, :vat_id %></small>
    </div>
  </div>
  <%= render "shared/forms/submit", path: root_path %>
<% end %>
